{
  "version": "crew.v1",
  "bugsFile": "BUGS.md",
  "baseBranch": null,
  "tracker": "local",
  "commands": {
    "install": null,
    "typecheck": null,
    "lint": null,
    "test": null,
    "build": null,
    "migrateDev": null,
    "migrateProd": null,
    "deploy": null,
    "verifyUrl": null
  },
  "guard": {
    "askPatterns": [],
    "denyPatterns": [],
    "externalWritePatterns": []
  },
  "roles": {
    "orchestrator": { "implementer": "main", "model": "claude-fable-5-1", "effort": "medium" },
    "backend": { "implementer": "codex", "model": "gpt-5.6-sol", "effort": "high", "fallback": "crew:backend-builder" },
    "frontend": { "implementer": "agent", "agent": "crew:frontend-builder" },
    "integrator": { "implementer": "agent", "agent": "crew:frontend-builder" },
    "review": { "implementer": "codex", "model": "gpt-6-astra", "effort": "high", "fallback": "crew:reviewer" },
    "finalReview": { "implementer": "codex", "model": "gpt-6-astra", "effort": "xhigh", "fallback": "crew:reviewer" },
    "escalation": { "implementer": "codex", "model": "gpt-6-astra", "effort": "xhigh", "fallback": "crew:backend-builder" },
    "migrations": { "implementer": "agent", "agent": "crew:migration-runner" }
  },
  "limits": {
    "parallel": 3,
    "fixRounds": 5,
    "ciFixRounds": 3,
    "maxAgentTurns": 120
  },
  "//models": "Implementer model and effort per ticket Size. Measured on the first real run: implementers were 69% of the whole token bill and reviewers 4%, so this table is the main cost dial. A ticket that needs more than limits.maxAgentTurns was sized wrong — split it instead of buying a bigger model.",
  "//reviewRule": "THE REVIEWER IS NEVER WEAKER THAN THE IMPLEMENTER. A previous-generation model of the same family is not independence, it is a downgrade — Opus 4.8 and Opus 5 cost the same $5/$25 per Mtok, so reviewing Opus 5's work with 4.8 buys nothing and loses capability. Independence comes from a DIFFERENT family (Codex gpt-6-astra by default); when that is unavailable, review with the implementer's tier or one above it.",
  "models": {
    "implementerBySize": {
      "S": { "model": "sonnet", "effort": "medium" },
      "M": { "model": "sonnet", "effort": "high" },
      "L": { "model": "opus", "effort": "high" }
    },
    "reviewerBySize": {
      "S": { "model": "sonnet", "effort": "medium" },
      "M": { "model": "opus", "effort": "high" },
      "L": { "model": "opus", "effort": "high" }
    }
  },
  "keepGoing": {
    "maxNoProgress": 3,
    "maxContinuations": 300,
    "staleMinutes": 45
  }
}
